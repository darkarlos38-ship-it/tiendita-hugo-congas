{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiendita-hugo-congas",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hugo-congas-db",
      "database_id": "b49b1658-9618-44a7-a623-5d6b22c19a85"
    }
  ]
}
